# ============================================
# Half-Lens Platform — Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Frontend (Vite) ─────────────────────────
# These are exposed to the browser (VITE_ prefix)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Supabase Edge Functions ─────────────────
# Set these in Supabase Dashboard → Edge Functions → Secrets

# Required: Supabase connection
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required: SMTP for sending OTP & status emails
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM_EMAIL=noreply@halflens.com
# SMTP_FROM_NAME=Half Lens

# Required: App URLs
# APP_BASE_URL=https://halflens.com
# VENDOR_LOGIN_URL=https://halflens.com/vendor-login
# ADMIN_URL=https://halflens.com/#vendors

# Required: CORS — set to your frontend domain in production
# ALLOWED_ORIGIN=https://halflens.com

# Optional: Email branding
# EMAIL_LOGO_URL=https://your-project.supabase.co/storage/v1/object/public/email-assets/logo-white.png
# EMAIL_LOGO_BLUE_URL=https://your-project.supabase.co/storage/v1/object/public/email-assets/logo-blue.png

# Optional: AI document extraction (Anthropic Claude)
# ANTHROPIC_API_KEY=sk-ant-your-key-here
